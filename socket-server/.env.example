# Set to a secure random string. The Vercel API must use the same secret to call POST /emit.
EMIT_SECRET=change-me-to-a-secure-random-string

# Comma-separated origins. Use * for development, or your domain for production.
ALLOWED_ORIGINS=*

# Port for the socket server (defaults to 3001 locally; Railway/Render set PORT automatically)
PORT=3001

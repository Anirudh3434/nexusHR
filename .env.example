# Email Integration - OAuth Configuration

# Gmail OAuth Settings
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable Gmail API
# 3. Create OAuth 2.0 credentials
# 4. Add redirect URI: http://localhost:3000/api/auth/gmail/callback
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
# For development, use HTTPS via ngrok (see instructions below)
# GMAIL_REDIRECT_URI=https://your-ngrok-url.ngrok.io/api/auth/gmail/callback
# For production:
GMAIL_REDIRECT_URI=https://yourdomain.com/api/auth/gmail/callback

# Microsoft/Outlook OAuth Settings
# Get these from Azure Portal: https://portal.azure.com/
# 1. Register a new application
# 2. Add API permissions: Mail.Read, Mail.Send, User.Read
# 3. Add redirect URI: http://localhost:3000/api/auth/outlook/callback
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback

# MongoDB Connection (if not already set)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hrm

# NextAuth/JWT Secret (if using authentication)
JWT_SECRET=your_jwt_secret_here

# GitHub Integration - OAuth Configuration
# Get these from GitHub Developer Settings: https://github.com/settings/developers
# 1. Create a new OAuth App
# 2. Set Authorization callback URL: http://localhost:3000/api/github/callback
# 3. For production, use your domain: https://yourdomain.com/api/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback

# GitHub Webhook Secret (for secure webhook verification)
# Generate a random string and use it when creating webhooks
GITHUB_WEBHOOK_SECRET=your_random_webhook_secret_here

# App URL (used for webhook configuration)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Socket.IO server (persistent host for real-time updates)
# Mobile app and web dashboard connect here for WebSocket events
SOCKET_SERVER_URL=https://your-socket-server-url.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://your-socket-server-url.onrender.com
